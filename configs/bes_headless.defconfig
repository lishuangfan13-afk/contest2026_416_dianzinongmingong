#
# end of Bluetooth socket support

#
# IEEE 802.15.4 socket support
#
# end of IEEE 802.15.4 socket support

#
# ICMP Networking Support
#
CONFIG_NET_ICMP=y
# CONFIG_NET_ICMP_NO_STACK is not set
CONFIG_NET_ICMP_PMTU_ENTRIES=0
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NET_ICMP_CHECKSUMS=y
CONFIG_NET_ICMP_PREALLOC_CONNS=4
CONFIG_NET_ICMP_ALLOC_CONNS=1
CONFIG_NET_ICMP_MAX_CONNS=0
CONFIG_NET_ICMP_NPOLLWAITERS=2
# end of ICMP Networking Support

#
# ICMPv6 Networking Support
#
CONFIG_NET_ICMPv6=y
# CONFIG_NET_ICMPv6_NO_STACK is not set
CONFIG_NET_ICMPv6_PMTU_ENTRIES=0
CONFIG_NET_ICMPv6_SOCKET=y
CONFIG_NET_ICMPv6_CHECKSUMS=y
# CONFIG_NET_ICMPv6_NEIGHBOR is not set
CONFIG_NET_ICMPv6_AUTOCONF=y
CONFIG_ICMPv6_AUTOCONF_MAXTRIES=10
CONFIG_ICMPv6_AUTOCONF_DELAYMSEC=500
# CONFIG_ICMPv6_AUTOCONF_RDNSS is not set
# CONFIG_NET_ICMPv6_ROUTER is not set
CONFIG_NET_ICMPv6_PREALLOC_CONNS=4
CONFIG_NET_ICMPv6_ALLOC_CONNS=0
CONFIG_NET_ICMPv6_NPOLLWAITERS=1
# end of ICMPv6 Networking Support

# CONFIG_NET_MLD is not set
CONFIG_NET_IGMP=y
CONFIG_NET_IGMP_CHECKSUMS=y

#
# ARP Configuration
#
CONFIG_NET_ARP=y
CONFIG_NET_ARPTAB_SIZE=48
CONFIG_NET_ARP_MAXAGE=120
CONFIG_NET_ARP_MAXAGE_UNREACHABLE=1
CONFIG_NET_ARP_IPIN=y
# CONFIG_NET_ARP_GRATUITOUS is not set
CONFIG_NET_ARP_SEND=y
# CONFIG_NET_ARP_SEND_QUEUE is not set
CONFIG_ARP_SEND_MAXTRIES=5
CONFIG_ARP_SEND_DELAYMSEC=20
CONFIG_NET_ARP_PREALLOC_STATES=2
CONFIG_NET_ARP_ALLOC_STATES=1
CONFIG_NET_ARP_MAX_STATES=0
# CONFIG_NET_ARP_ACD is not set
# end of ARP Configuration

#
# User-space networking stack API
#
# CONFIG_NET_USRSOCK is not set
# end of User-space networking stack API

# CONFIG_NET_ARCH_INCR32 is not set
# CONFIG_NET_ARCH_CHKSUM is not set
CONFIG_NET_SNOOP_BUFSIZE=4096
CONFIG_NET_RECV_PACK=y

#
# Virtual Socket networking stack API
#
# CONFIG_NET_VSOCK_VIRTIO is not set
# CONFIG_NET_VSOCK_VHOST is not set
# CONFIG_NET_VSOCK_LOCAL is not set
# end of Virtual Socket networking stack API

CONFIG_NET_STATISTICS=y

#
# Network Topologies
#
# end of Network Topologies

#
# Routing Table Configuration
#
CONFIG_NET_ROUTE=y
CONFIG_ROUTE_IPv4_RAMROUTE=y
# CONFIG_ROUTE_IPv4_ROMROUTE is not set
# CONFIG_ROUTE_IPv4_FILEROUTE is not set
CONFIG_ROUTE_MAX_IPv4_RAMROUTES=4
CONFIG_ROUTE_IPv6_RAMROUTE=y
# CONFIG_ROUTE_IPv6_ROMROUTE is not set
# CONFIG_ROUTE_IPv6_FILEROUTE is not set
CONFIG_ROUTE_MAX_IPv6_RAMROUTES=4
CONFIG_ROUTE_LONGEST_MATCH=y
# end of Routing Table Configuration

# CONFIG_NET_NO_LTO is not set
# end of Networking Support

