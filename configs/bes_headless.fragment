# Merge into the working BES AP configuration; keep the verified audio backend.
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_PROGNAME="ai_agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_DATA_DIR="/emmc/zhaoxi"
CONFIG_EXAMPLES_ZHAOXI=y
CONFIG_ZHAOXI_BES_AUDIO=y
CONFIG_ZHAOXI_MIMO_VOICE=y
CONFIG_NETUTILS_CJSON=y
CONFIG_CRYPTO_MBEDTLS=y
CONFIG_MBEDTLS_NET_C=y
CONFIG_FS_FATFS=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_SYSLOG_CONSOLE=y
# CONFIG_SYSLOG_DEFAULT is not set
# CONFIG_EXAMPLES_ZHAOXI_UI is not set
# CONFIG_AI_AGENT_LVGL_UI is not set
# CONFIG_GRAPHICS_LVGL is not set
# CONFIG_AI_AGENT_FEISHU is not set
# CONFIG_AI_AGENT_WEIXIN is not set
# CONFIG_AI_AGENT_MQTT is not set
# CONFIG_AI_AGENT_SKILL_SYNC is not set
# CONFIG_FEATURE_SYSTEM_VELACLAW is not set
# Optional wired PPP transport over USB2UART.
CONFIG_NETUTILS_PPPD=y
