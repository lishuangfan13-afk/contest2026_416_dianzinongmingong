# Keep the bytes used by the fixed diagnostic source checks consistent on Windows and Linux.
/diagnostics/bes_audio/** text eol=lf
/tools/bes_audio/*.py text eol=lf
/firmware/*.tar.xz binary
/app/zhaoxi/** text eol=lf
/tests/headless/** text eol=lf
/assets/agent_deploy/** text eol=lf
/configs/** text eol=lf
/README.md text eol=lf
/docs/*.md text eol=lf
# Unified-diff blank context lines carry a required space marker.
/patches/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
/patches/README.md text eol=lf
/tools/*.py text eol=lf
/tools/*.ps1 text eol=lf
/.gitattributes text eol=lf
