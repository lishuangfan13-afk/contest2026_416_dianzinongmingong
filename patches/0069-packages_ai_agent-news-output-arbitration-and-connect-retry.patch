--- a/src/infra/network_manager.c
+++ b/src/infra/network_manager.c
@@ -21,6 +21,7 @@
 #include <ifaddrs.h>
 #include <net/if.h>
 #include <netinet/in.h>
+#include <pthread.h>
 #include <string.h>
 #include <sys/socket.h>
 #include <sys/types.h>
@@ -30,6 +31,34 @@
 static const char* TAG = "netmgr";
 
 static char s_ip_str[INET_ADDRSTRLEN] = "0.0.0.0";
+
+/* ZHAOXI_WIFI_AWAKE_BEGIN */
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+extern int wapi_set_power_save(int sock,const char *ifname,bool on);
+static pthread_mutex_t s_wifi_awake_lock=PTHREAD_MUTEX_INITIALIZER;
+static uint32_t s_wifi_awake_address;
+static int64_t s_wifi_awake_next;
+static void zhaoxi_wifi_awake(const char *ifname,uint32_t address)
+{
+    if(ifname && strcmp(ifname,"wlan0"))return;
+    if(pthread_mutex_trylock(&s_wifi_awake_lock))return;
+    if(!ifname || !address){s_wifi_awake_address=0;s_wifi_awake_next=0;}
+    else {
+        struct timespec ts;clock_gettime(CLOCK_MONOTONIC,&ts);
+        int64_t now=(int64_t)ts.tv_sec*1000+ts.tv_nsec/1000000;
+        if(address!=s_wifi_awake_address || now>=s_wifi_awake_next) {
+            int fd=socket(AF_INET,SOCK_DGRAM,0),rc=-1;
+            if(fd>=0){rc=wapi_set_power_save(fd,ifname,false);close(fd);}
+            /* Reapply after a reconnect/IP change, and periodically in case
+             * the driver reset its setting during a fast reassociation. */
+            s_wifi_awake_address=address;s_wifi_awake_next=now+(rc?30000:60000);
+            syslog(rc?LOG_WARNING:LOG_INFO,"[%s] WIFI_POWER_SAVE off rc=%d\n",TAG,rc);
+        }
+    }
+    pthread_mutex_unlock(&s_wifi_awake_lock);
+}
+#endif
+/* ZHAOXI_WIFI_AWAKE_END */
 
 bool network_is_connected(void)
 {
