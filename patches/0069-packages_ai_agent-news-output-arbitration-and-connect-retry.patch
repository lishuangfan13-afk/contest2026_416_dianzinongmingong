diff --git a/src/infra/vela_tls.c b/src/infra/vela_tls.c
--- a/src/infra/vela_tls.c
+++ b/src/infra/vela_tls.c
@@ -1406,6 +1406,22 @@
 
 /* Dedicated bounded connection for background work. Normal ASR/TTS and LLM
  * calls retain their existing timeout and connection behaviour. */
+static int tls_connect_retry(tls_ctx_t *ctx,const char *host,const char *port,
+    unsigned budget,int (*cancel)(void *),void *user)
+{
+    /* Retry connection establishment only: no HTTP body or PCM has yet been
+     * sent. Both attempts share the original 15-second connection budget. */
+    unsigned total=budget<15000?budget:15000;
+    int64_t end=bounded_now_ms()+total;
+    int rc=tls_ctx_connect_limited(ctx,host,port,total>8000?8000:total,cancel,user);
+    int64_t left=end-bounded_now_ms();
+    if(rc && (rc==VELA_TLS_ERR_CONNECT || rc==VELA_TLS_ERR_HANDSHAKE || rc==VELA_TLS_ERR_TIMEOUT) &&
+       left>=1000 && (!cancel || !cancel(user))) {
+        ctx->abortive_close=true;tls_ctx_free(ctx);memset(ctx,0,sizeof(*ctx));
+        rc=tls_ctx_connect_limited(ctx,host,port,(unsigned)left,cancel,user);
+    }
+    return rc;
+}
