+#ifdef CONFIG_EXAMPLES_ZHAOXI
+/* LCP sends an Echo every >20 seconds. Allow three such intervals without
+ * a valid received frame; the owner polls this even when no data is sent.
+ */
+
+#define PPP_PC_LINK_RX_TIMEOUT (3 * (LCP_ECHO_INTERVAL + 1))
+
+static inline bool ppp_pc_link_expired(FAR struct ppp_context_s *ctx)
+{
+  return ctx->pc_link_managed &&
+         ppp_arch_clock_seconds() - ctx->pc_link_last_rx >=
+         PPP_PC_LINK_RX_TIMEOUT;
+}
+#endif
 
