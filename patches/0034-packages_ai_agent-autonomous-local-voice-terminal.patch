+/* Autonomous local VAD terminal. Start once; silence never calls ASR.
+ * Only the product BES backend currently provides this mode. Stop requests
+ * cancellation; status reports when any in-flight network work has drained. */
+enum voice_auto_feedback_event {
+    VOICE_AUTO_FEEDBACK_CAPTURE_ERROR=1,
+    VOICE_AUTO_FEEDBACK_ASR_ERROR=2,
+    VOICE_AUTO_FEEDBACK_TURN_TIMEOUT=3,
+    VOICE_AUTO_FEEDBACK_DISPATCH_ERROR=4
+};
+/* Optional weak product hook. Called with capture closed; may play a local
+ * bounded alert. It must not call cloud TTS or reenter automatic startup. */
+void voice_channel_auto_feedback(int event);
+
+int voice_channel_auto_start(void);
+int voice_channel_auto_stop(void);
+int voice_channel_auto_status(char *output, size_t capacity);
+
+/* Call after dispatching the final voice_auto reply, including TTS failure.
+ * Unrelated reminders must not complete the pending conversational turn. */
+void voice_channel_auto_reply_done(void);
+
 /* Synthesize text and play back (called from outbound dispatcher). */
 int voice_channel_speak(const char *text);
 
