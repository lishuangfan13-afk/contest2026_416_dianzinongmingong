 static bool g_initialized = false;
-static volatile bool g_bus_shutdown = false;
+static atomic_bool g_bus_shutdown = false;
+/* Protect initialization/teardown against external command submissions. */
+static pthread_mutex_t g_lifecycle_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t g_idle = PTHREAD_COND_INITIALIZER;
+static unsigned int g_active_operations;
+
+static bool bus_enter(void)
+{
+    pthread_mutex_lock(&g_lifecycle_lock);
+    bool ready = g_initialized && !atomic_load(&g_bus_shutdown);
+    if (ready) g_active_operations++;
+    pthread_mutex_unlock(&g_lifecycle_lock);
+    return ready;
+}
+
+static void bus_leave(void)
+{
+    pthread_mutex_lock(&g_lifecycle_lock);
+    if (--g_active_operations == 0) pthread_cond_broadcast(&g_idle);
+    pthread_mutex_unlock(&g_lifecycle_lock);
+}
 
