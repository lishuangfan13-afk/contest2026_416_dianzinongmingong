+/* Caller holds the lifecycle lock. Wake producers as well as consumers. */
+static void bus_wakeup_locked(void)
+{
+    g_bus_shutdown = true;
+    pthread_mutex_lock(&g_inbound_queue.lock);
+    pthread_cond_broadcast(&g_inbound_queue.not_empty);
+    pthread_cond_broadcast(&g_inbound_queue.not_full);
+    pthread_mutex_unlock(&g_inbound_queue.lock);
+    pthread_mutex_lock(&g_outbound_queue.lock);
+    pthread_cond_broadcast(&g_outbound_queue.not_empty);
+    pthread_cond_broadcast(&g_outbound_queue.not_full);
+    pthread_mutex_unlock(&g_outbound_queue.lock);
+}
+
 void message_bus_destroy(void)
 {
+    pthread_mutex_lock(&g_lifecycle_lock);
     if (!g_initialized) {
+        pthread_mutex_unlock(&g_lifecycle_lock);
         return;
     }
-
+    bus_wakeup_locked();
+    while (g_active_operations) pthread_cond_wait(&g_idle, &g_lifecycle_lock);
     msg_queue_destroy(&g_inbound_queue);
     msg_queue_destroy(&g_outbound_queue);
     g_initialized = false;
-
+    pthread_mutex_unlock(&g_lifecycle_lock);
     syslog(LOG_INFO, "[%s] Message bus destroyed\n", TAG);
 }
 
 void message_bus_wakeup(void)
 {
-    g_bus_shutdown = true;
-
-    pthread_mutex_lock(&g_inbound_queue.lock);
-    pthread_cond_broadcast(&g_inbound_queue.not_empty);
-    pthread_mutex_unlock(&g_inbound_queue.lock);
-
-    pthread_mutex_lock(&g_outbound_queue.lock);
-    pthread_cond_broadcast(&g_outbound_queue.not_empty);
-    pthread_mutex_unlock(&g_outbound_queue.lock);
+    pthread_mutex_lock(&g_lifecycle_lock);
+    if (g_initialized) bus_wakeup_locked();
+    pthread_mutex_unlock(&g_lifecycle_lock);
+}
+
+bool message_bus_is_ready(void)
+{
+    pthread_mutex_lock(&g_lifecycle_lock);
+    bool ready = g_initialized && !atomic_load(&g_bus_shutdown);
+    pthread_mutex_unlock(&g_lifecycle_lock);
+    return ready;
 }
 
