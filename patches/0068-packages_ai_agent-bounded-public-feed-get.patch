+int vela_https_get_bounded(const char *host,const char *port,const char *path,
+    char *out,size_t capacity,unsigned budget,int (*cancel)(void *),void *user)
+{
+    if(!host || !port || !path || !out || capacity<2 || !budget || budget>60000)
+        return VELA_TLS_ERR_OVERFLOW;
+    out[0]=0;
+    tls_ctx_t *ctx=calloc(1,sizeof(*ctx));if(!ctx)return VELA_TLS_ERR_OVERFLOW;
+    int64_t end=bounded_now_ms()+budget;
+    int rc=tls_ctx_connect_limited(ctx,host,port,budget<15000?budget:15000,cancel,user);
+    if(!rc)ctx->request_deadline=end;
+    vela_header_t headers[]={{"Accept","application/json"},{"Accept-Encoding","identity"},{NULL,NULL}};
+    if(!rc)rc=tls_write_request(ctx,"GET",host,path,headers,NULL,0);
+    if(!rc)rc=tls_read_response(ctx,out,capacity,NULL,NULL,false);
+    ctx->abortive_close=rc<0;
+    tls_ctx_free(ctx);free(ctx);
+    if(rc<0)out[0]=0;
+    return rc;
+}
