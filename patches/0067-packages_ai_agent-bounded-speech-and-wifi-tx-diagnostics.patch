+/* Opt-in diagnostic for the direct Wi-Fi path. Keep queued bulk audio small
+ * without changing PPP, global TCP defaults or the TLS record format. */
+static int zhaoxi_apply_wifi_tx_buffer(int fd)
+{
+    int saved_errno=errno;char mode[16]={0},value[16]={0};
+    if(claw_config_get("uplink_mode",mode,sizeof(mode)) || strcmp(mode,"wifi") ||
+       claw_config_get("wifi_tls_tx_buffer",value,sizeof(value))){errno=saved_errno;return 0;}
+    int requested=!strcmp(value,"8192")?8192:!strcmp(value,"16384")?16384:
+                  !strcmp(value,"32768")?32768:0;
+    if(!requested){errno=saved_errno;return 0;}
+    struct ifaddrs *list=NULL;bool wifi=false,ppp=false;
+    if(!getifaddrs(&list)) {
+        for(struct ifaddrs *at=list;at;at=at->ifa_next) {
+            if(!at->ifa_name || !at->ifa_addr || at->ifa_addr->sa_family!=AF_INET ||
+               (at->ifa_flags&(IFF_UP|IFF_RUNNING))!=(IFF_UP|IFF_RUNNING) ||
+               !((struct sockaddr_in *)at->ifa_addr)->sin_addr.s_addr)continue;
+            if(!strcmp(at->ifa_name,"wlan0"))wifi=true;
+            if(!strcmp(at->ifa_name,"ppp0"))ppp=true;
+        }
+        freeifaddrs(list);
+    }
+    int result=0;
+    if(wifi && !ppp) {
+        char mss_value[16]={0};claw_config_get("wifi_tcp_mss",mss_value,sizeof(mss_value));
+        int mss=!strcmp(mss_value,"256")?256:!strcmp(mss_value,"472")?472:
+                !strcmp(mss_value,"512")?512:!strcmp(mss_value,"1024")?1024:0;
+        if(mss) {
+            int mss_rc=setsockopt(fd,IPPROTO_TCP,TCP_MAXSEG,&mss,sizeof(mss));
+            syslog(LOG_INFO,"[%s] TLS_WIFI_MSS requested=%d set_rc=%d\n",TAG,mss,mss_rc);
+        }
+        int actual=-1;socklen_t size=sizeof(actual);
+        int rc=setsockopt(fd,SOL_SOCKET,SO_SNDBUF,&requested,sizeof(requested));
+        int get_rc=rc?-1:getsockopt(fd,SOL_SOCKET,SO_SNDBUF,&actual,&size);
+        if(!rc && !get_rc && actual>0) {
+            char record[16]={0};claw_config_get("wifi_tls_record_size",record,sizeof(record));
+            result=!strcmp(record,"0")?0:!strcmp(record,"512")?512:
+                   !strcmp(record,"2048")?2048:!strcmp(record,"4096")?4096:1024;
+        }
+        syslog(LOG_INFO,"[%s] TLS_WIFI_TX requested=%d actual=%d set_rc=%d get_rc=%d record_bytes=%d\n",
+               TAG,requested,actual,rc,get_rc,result);
+    }
+    errno=saved_errno;return result;
+}
