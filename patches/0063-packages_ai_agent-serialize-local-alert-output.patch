+/* Synchronous bounded local PCM output. The callback owns its codec handle
+ * and closes it before returning. Call started() after the first successful
+ * PCM write; it changes display state only and must not be retained. The
+ * scope excludes automatic capture and serializes with cloud speech on all
+ * success/error returns. The callback must not reenter voice output APIs. */
+typedef int (*voice_local_playback_cb)(void *context, void (*started)(void));
+int voice_channel_play_local(voice_local_playback_cb callback, void *context);
