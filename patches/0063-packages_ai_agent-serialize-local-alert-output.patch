+/* A local alert uses the same capture exclusion and output mutex as TTS.
+ * The callback's first successful write marks actual PCM output. */
+static void local_playback_started(void)
+{
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+    pthread_mutex_lock(&s_auto.lock);
+    if (s_auto.speakers) s_auto.tts_playing = true;
+    pthread_mutex_unlock(&s_auto.lock);
+#endif
+}
+
+int voice_channel_play_local(voice_local_playback_cb callback, void *context)
+{
+    if (!callback) return -EINVAL;
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+    voice_auto_pause_for_tts();
+#endif
+    int lock_result = pthread_mutex_lock(&s_voice.speak_lock);
+    int result = lock_result ? -lock_result : callback(context, local_playback_started);
+    if (!lock_result) pthread_mutex_unlock(&s_voice.speak_lock);
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+    voice_auto_resume_after_tts();
+#endif
+    return result;
+}
+
