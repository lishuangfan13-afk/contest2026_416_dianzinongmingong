+static bool ascii_word(unsigned char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+           (c >= '0' && c <= '9') || c == '_';
+}
+static const char *consume_ascii(const char *text, const char *part)
+{
+    for (; *part; part++, text++) {
+        unsigned char c = (unsigned char)*text;
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != (unsigned char)*part) return NULL;
+    }
+    return text;
+}
