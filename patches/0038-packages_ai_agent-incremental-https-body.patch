+int vela_https_post_json_stream(const char *host, const char *port, const char *path,
+    const vela_header_t *extra_headers, const char *json_body,
+    vela_https_body_cb callback, void *user)
+{
+    if (!host || !*host || !port || !*port || !path || path[0] != '/' ||
+        !json_body || !callback || strchr(host, '\r') || strchr(host, '\n') ||
+        strchr(path, '\r') || strchr(path, '\n')) return VELA_TLS_ERR_PROTOCOL;
+    vela_header_t merged[32]; unsigned n = 0;
+    merged[n++] = (vela_header_t){"Content-Type", "application/json"};
+    merged[n++] = (vela_header_t){"Accept", "text/event-stream"};
+    merged[n++] = (vela_header_t){"Accept-Encoding", "identity"};
+    if (extra_headers) for (const vela_header_t *h = extra_headers; h->name; h++) {
+        if (n >= 31 || !h->value || strchr(h->name, '\r') || strchr(h->name, '\n') ||
+            strchr(h->value, '\r') || strchr(h->value, '\n')) return VELA_TLS_ERR_OVERFLOW;
+        merged[n++] = *h;
+    }
+    merged[n] = (vela_header_t){NULL, NULL};
+    tls_ctx_t *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx) return VELA_TLS_ERR_OVERFLOW;
+    int result = tls_ctx_connect(ctx, host, port);
+    if (!result) result = tls_write_request(ctx, "POST", host, path, merged,
+                                           json_body, strlen(json_body));
+    if (!result) {
+        tls_stream_bio_t bio = {&ctx->net, tls_stream_now_ms() + TLS_STREAM_TIMEOUT_MS};
+        mbedtls_ssl_set_bio(&ctx->ssl, &bio, tls_stream_send, tls_stream_recv, NULL);
+        result = tls_read_response_stream(ctx, callback, user, bio.deadline);
+        /* The stack BIO must not outlive this block during close_notify. */
+        mbedtls_ssl_set_bio(&ctx->ssl, &ctx->net, mbedtls_net_send,
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+                             zhaoxi_tls_recv,
+#else
+                             mbedtls_net_recv,
+#endif
+                             NULL);
+    }
+    tls_ctx_free(ctx); free(ctx); return result;
+}
