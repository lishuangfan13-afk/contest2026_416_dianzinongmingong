+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <pthread.h>
+#include <stdbool.h>
+
+bool agent_instance_acquire(void);
+void agent_instance_release(void);
+int agent_tracked_pthread_create(pthread_t *thread, const pthread_attr_t *attr,
+    void *(*function)(void *), void *argument, const char *name);
+void agent_tasks_wait(bool network_only);
--- /dev/null
+++ b/src/infra/task_lifecycle.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "task_lifecycle.h"
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern bool agent_shutdown_requested(void);
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static bool active;
+static unsigned workers, network_workers;
+
+struct tracked_task {
+    void *(*function)(void *);
+    void *argument;
+    bool network;
+};
+
+bool agent_instance_acquire(void)
+{
+    pthread_mutex_lock(&lock);
+    bool acquired = !active;
+    if (acquired) active = true;
+    pthread_mutex_unlock(&lock);
+    return acquired;
+}
+
+void agent_instance_release(void)
+{
+    pthread_mutex_lock(&lock);
+    active = false;
+    pthread_mutex_unlock(&lock);
+}
+
+static void task_finished(void *argument)
+{
+    struct tracked_task *task = argument;
+    pthread_mutex_lock(&lock);
+    --workers;
+    if (task->network) --network_workers;
+    pthread_cond_broadcast(&changed);
+    pthread_mutex_unlock(&lock);
+    free(task);
+}
+
+static void *task_run(void *argument)
+{
+    struct tracked_task *task = argument;
+    void *result;
+    pthread_cleanup_push(task_finished, task);
+    result = task->function(task->argument);
+    pthread_cleanup_pop(1);
+    return result;
+}
+
+int agent_tracked_pthread_create(pthread_t *thread, const pthread_attr_t *attr,
+    void *(*function)(void *), void *argument, const char *name)
+{
+    struct tracked_task *task = malloc(sizeof(*task));
+    if (!task) return ENOMEM;
+    task->function = function;
+    task->argument = argument;
+    task->network = name && strcmp(name, "net_watch") == 0;
+    pthread_mutex_lock(&lock);
+    if (agent_shutdown_requested()) {
+        pthread_mutex_unlock(&lock);
+        free(task);
+        return ECANCELED;
+    }
+    ++workers;
+    if (task->network) ++network_workers;
+    pthread_mutex_unlock(&lock);
+    int result = pthread_create(thread, attr, task_run, task);
+    if (result) task_finished(task);
+    return result;
+}
+
+void agent_tasks_wait(bool network_only)
+{
+    pthread_mutex_lock(&lock);
+    while (network_only ? network_workers != 0 : workers != 0)
+        pthread_cond_wait(&changed, &lock);
+    pthread_mutex_unlock(&lock);
+}
