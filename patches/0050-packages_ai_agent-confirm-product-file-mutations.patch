+/* Side-effect confirmation belongs to this turn's tool evidence, not model
+ * prose, prior conversation or a cached success response. Classification uses
+ * explicit command prefixes; ordinary how-to/list questions remain Q&A. */
+typedef enum { PRODUCT_MUTATION_NONE, PRODUCT_MUTATION_NOTE,
+               PRODUCT_MUTATION_TODO } product_mutation_t;
+
+static product_mutation_t product_mutation_intent(const char *request)
+{
+    if (!request) return PRODUCT_MUTATION_NONE;
+    while (*request == ' ' || *request == '\t' || *request == '\n') request++;
+    static const char *todo[] = {
+        "请使用智能记事本添加待办", "请使用智能记事本读取待办，只完成指定编号",
+        "添加待办", "新增待办", "完成待办", "标记待办", "取消待办", "删除待办",
+        "帮我添加待办", "帮我新增待办", "帮我完成待办", "帮我删除待办",
+        "帮我加个待办", "加个待办", "添加一条待办", "添加一个待办",
+        "请添加待办", "请完成待办", "请删除待办", "add todo ", "add a todo ",
+        "complete todo ", "delete todo ", NULL
+    };
+    static const char *note[] = {
+        "请使用智能记事本记录这条备忘", "记一下", "记下", "记住", "记录一下", "记个事",
+        "帮我记", "请帮我记", "请记下", "请记录", "添加备忘", "新增备忘",
+        "帮我添加备忘", "add note ", "add a note ", "remember ", NULL
+    };
+    /* Exact numbered-completion grammar, not a keyword found inside a
+     * question such as "把编号3是什么解释一下". */
+    const char *numbered = "把编号";
+    if (!strncmp(request, numbered, strlen(numbered))) {
+        const char *end = request + strlen(numbered);
+        if (*end >= '1' && *end <= '9') {
+            int digits = 0;
+            while (*end >= '0' && *end <= '9') { end++; digits++; }
+            const char *actions[] = {"标完成", "标为完成", "标记为完成", NULL};
+            for (int i = 0; digits <= 4 && actions[i]; i++) {
+                size_t n = strlen(actions[i]);
+                if (strncmp(end, actions[i], n)) continue;
+                const char *tail = end + n;
+                while (*tail == ' ' || *tail == '\t') tail++;
+                if (!*tail || !strcmp(tail,"。") || !strcmp(tail,"吧") ||
+                    !strcmp(tail,"！")) return PRODUCT_MUTATION_TODO;
+            }
+        }
+    }
+    for (int i = 0; todo[i]; i++)
+        if (!strncasecmp(request, todo[i], strlen(todo[i]))) return PRODUCT_MUTATION_TODO;
+    for (int i = 0; note[i]; i++)
+        if (!strncasecmp(request, note[i], strlen(note[i]))) return PRODUCT_MUTATION_NOTE;
+    return PRODUCT_MUTATION_NONE;
+}
+
+static bool product_mutation_path(product_mutation_t kind, const char *path)
+{
+    if (!path || strstr(path, "..")) return false;
+    if (kind == PRODUCT_MUTATION_TODO)
+        return !strcmp(path, AGENT_DATA_DIR "/TASKS.md");
+    const char *prefix = AGENT_DATA_DIR "/memory/daily/";
+    size_t n = strlen(prefix);
+    if (kind != PRODUCT_MUTATION_NOTE || strncmp(path, prefix, n)) return false;
+    const char *name = path + n;
+    if (strlen(name) != 13 || name[4] != '-' || name[7] != '-' || strcmp(name+10, ".md")) return false;
+    for (int i = 0; i < 10; i++)
+        if (i != 4 && i != 7 && (name[i] < '0' || name[i] > '9')) return false;
+    return true;
+}
+
+static bool product_mutation_committed(const cJSON *messages, int first,
+                                       product_mutation_t kind)
+{
+    int count = cJSON_GetArraySize(messages);
+    for (int i = first; i < count; i++) {
+        const cJSON *assistant = cJSON_GetArrayItem(messages, i);
+        const char *role = cJSON_GetStringValue(cJSON_GetObjectItem(assistant, "role"));
+        if (!role || strcmp(role, "assistant")) continue;
+        const cJSON *calls = cJSON_GetObjectItem(assistant, "tool_calls");
+        for (int j = 0; j < cJSON_GetArraySize(calls); j++) {
+            const cJSON *call = cJSON_GetArrayItem(calls, j);
+            const cJSON *fn = cJSON_GetObjectItem(call, "function");
+            const char *name = cJSON_GetStringValue(cJSON_GetObjectItem(fn, "name"));
+            const char *input = cJSON_GetStringValue(cJSON_GetObjectItem(fn, "arguments"));
+            const char *id = cJSON_GetStringValue(cJSON_GetObjectItem(call, "id"));
+            if (!name || !input || !id || (strcmp(name,"write_file") && strcmp(name,"edit_file"))) continue;
+            cJSON *args = cJSON_Parse(input);
+            const char *path = cJSON_GetStringValue(cJSON_GetObjectItem(args, "path"));
+            bool matching = product_mutation_path(kind, path);
+            cJSON_Delete(args);
+            if (!matching) continue;
+            const char *success = !strcmp(name, "write_file") ? "OK: wrote " : "OK: edited ";
+            for (int k = i+1; k < count; k++) {
+                const cJSON *result = cJSON_GetArrayItem(messages, k);
+                const char *result_role = cJSON_GetStringValue(cJSON_GetObjectItem(result, "role"));
+                if (!result_role || strcmp(result_role, "tool")) break;
+                const char *result_id = cJSON_GetStringValue(cJSON_GetObjectItem(result, "tool_call_id"));
+                const char *content = cJSON_GetStringValue(cJSON_GetObjectItem(result, "content"));
+                if (result_role && !strcmp(result_role,"tool") && result_id && !strcmp(result_id,id) && content && !strncmp(content,success,strlen(success))) return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void product_mutation_repair(cJSON *messages)
+{
+    cJSON *repair = cJSON_CreateObject();
+    cJSON_AddStringToObject(repair, "role", "user");
+    cJSON_AddStringToObject(repair, "content",
+        "本轮没有对应业务文件的成功写入或编辑结果，刚才的完成确认无效。"
+        "请继续调用工具，保留其他记录，实际保存后再确认；"
+        "若目标不存在、信息不清或工具失败，请明确说明未保存，不要声称成功。");
+    cJSON_AddItemToArray(messages, repair);
+}
