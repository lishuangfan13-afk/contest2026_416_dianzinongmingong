+/* Return the actual occupied size, not snprintf's would-have-written
+ * count, so later memory sections cannot step beyond a full buffer. */
+static size_t append_format(char *buf, size_t size, size_t off, const char *format, ...)
+{
+    if (!buf || !size) return 0;
+    if (off >= size - 1) return size - 1;
+    va_list args;
+    va_start(args, format);
+    int length = vsnprintf(buf + off, size - off, format, args);
+    va_end(args);
+    if (length < 0) { buf[off] = '\0'; return off; }
+    size_t room = size - off - 1;
+    return off + ((size_t)length < room ? (size_t)length : room);
+}
