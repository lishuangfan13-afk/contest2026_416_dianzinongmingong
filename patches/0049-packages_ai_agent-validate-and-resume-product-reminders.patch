+/* Caller holds s_cron_lock. Only schedule fields change here, so a small
+ * snapshot can roll them back if the new persistent schedule cannot be saved. */
+static int cron_prepare_start_locked(time_t now)
+{
+    struct { bool enabled; int64_t next_run; } previous[MAX_CRON_JOBS];
+    bool changed = false;
+    for (int i = 0; i < s_job_count; i++) {
+        previous[i].enabled = s_jobs[i].enabled;
+        previous[i].next_run = s_jobs[i].next_run;
+    }
+
+    for (int i = 0; i < s_job_count; i++) {
+        cron_job_t *job = &s_jobs[i];
+        if (!job->enabled) continue;
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+        if (job->kind == CRON_KIND_EVERY && !job->action[0]) {
+            /* A plain recurring reminder remains recurring after downtime.
+             * Skip missed ticks while preserving its original phase, without
+             * replaying a backlog or overflowing signed epoch arithmetic. */
+            uint64_t interval = job->interval_s;
+            if (!interval) {
+                job->enabled = false;
+                job->next_run = 0;
+            } else if (job->next_run <= 0) {
+                if ((int64_t)now > INT64_MAX - (int64_t)interval) {
+                    job->enabled = false;
+                    job->next_run = 0;
+                } else {
+                    job->next_run = (int64_t)now + (int64_t)interval;
+                }
+            } else if (job->next_run <= (int64_t)now) {
+                uint64_t ticks = ((uint64_t)now - (uint64_t)job->next_run) /
+                                     interval + 1;
+                uint64_t room = (uint64_t)(INT64_MAX - job->next_run) / interval;
+                if (ticks > room) {
+                    job->enabled = false;
+                    job->next_run = 0;
+                } else {
+                    job->next_run += (int64_t)(ticks * interval);
+                }
+            }
+            continue;
+        }
+#endif
+        /* Preserve the pre-existing policy for overdue one-shots and action
+         * jobs; restarting must not rerun an already missed external action. */
+        if (job->next_run > 0 && job->next_run <= (int64_t)now) {
+            job->enabled = false;
+            job->next_run = 0;
+            continue;
+        }
+        if (job->next_run <= 0) {
+            if (job->kind == CRON_KIND_EVERY) {
+                if ((int64_t)now > INT64_MAX - (int64_t)job->interval_s) {
+                    job->enabled = false;
+                } else {
+                    job->next_run = (int64_t)now + job->interval_s;
+                }
+            } else if (job->kind == CRON_KIND_AT && job->at_epoch > now) {
+                job->next_run = job->at_epoch;
+            }
+        }
+    }
+    for (int i = 0; i < s_job_count; i++) {
+        if (s_jobs[i].enabled != previous[i].enabled ||
+            s_jobs[i].next_run != previous[i].next_run) changed = true;
+    }
+    if (changed && cron_save_jobs() != OK) {
+        for (int i = 0; i < s_job_count; i++) {
+            s_jobs[i].enabled = previous[i].enabled;
+            s_jobs[i].next_run = previous[i].next_run;
+        }
+        syslog(LOG_ERR, "[%s] Cannot persist resumed schedule; start deferred\n", TAG);
+        return ERROR;
+    }
+    return OK;
+}
