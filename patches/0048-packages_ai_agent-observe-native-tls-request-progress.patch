 /* ── HTTP/1.1 framing ────────────────────────────────────────── */
 
+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+/* Counters describe plaintext accepted by TLS, not bytes acknowledged by the
+ * peer. No request headers, body, credentials or addresses are logged. */
+static int64_t tls_diag_now_ms(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (int64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+static void tls_diag_socket(tls_ctx_t *ctx, const char *stage,
+                            size_t plain_rx, int ssl_result, int bio_errno)
+{
+    int saved_errno = errno;
+    int fd = ctx->net.fd;
+    int rx_head = -1, tx_space = -1;
+    int rx_rc = -1, tx_rc = -1, path_rc = -1, path_errno = 0;
+    char path[PATH_MAX];
+    const char *metadata = "unsupported";
+    const char *protocol = "unknown";
+    path[0] = '\0';
+#ifdef FIONREAD
+    rx_rc = ioctl(fd, FIONREAD, (unsigned long)(uintptr_t)&rx_head);
+#endif
+#ifdef FIONSPACE
+    tx_rc = ioctl(fd, FIONSPACE, (unsigned long)(uintptr_t)&tx_space);
+#endif
+#if defined(__NuttX__) && defined(FIOC_FILEPATH)
+    /* This NuttX tree has no TCP_INFO. FIOC_FILEPATH provides queue/state
+     * metadata without clearing pending socket errors. Its prefix contains
+     * addresses: retain only the suffix starting at the first comma. */
+    path_rc = ioctl(fd, FIOC_FILEPATH, (unsigned long)(uintptr_t)path);
+    path_errno = path_rc < 0 ? errno : 0;
+    if (!path_rc) {
+        /* Only known socket formats may expose their non-address suffix. */
+        if (strncmp(path, "tcp:[", 5) == 0) protocol = "tcp";
+        else if (strncmp(path, "udp:[", 5) == 0) protocol = "udp";
+        else protocol = "other";
+        const char *suffix = strchr(path, ',');
+        metadata = suffix && strcmp(protocol, "other") != 0
+                 ? suffix + 1 : "unavailable";
+    }
+#endif
+    syslog(LOG_INFO,
+        "[%s] TLS_SOCKET stage=%s fd=%d plain_rx=%lu ssl_ret=%d bio_errno=%d "
+        "rx_head=%d rx_rc=%d tx_space=%d tx_rc=%d path_rc=%d path_errno=%d protocol=%s meta=%s\n",
+        TAG, stage, fd, (unsigned long)plain_rx, ssl_result, bio_errno,
+        rx_head, rx_rc, tx_space, tx_rc, path_rc, path_errno, protocol, metadata);
+    errno = saved_errno;
+}
+
+static void tls_diag_write(tls_ctx_t *ctx, size_t header_expected,
+                           size_t header_accepted, size_t body_expected,
+                           size_t body_accepted, unsigned calls,
+                           unsigned retries, int64_t started,
+                           int last_ssl_result, int last_errno, int result)
+{
+    int saved_errno = errno;
+    syslog(LOG_INFO,
+        "[%s] TLS_TX phase=request header=%lu/%lu body=%lu/%lu calls=%u "
+        "want_write=%u elapsed_ms=%lld last_ssl_ret=%d last_errno=%d rc=%d\n",
+        TAG, (unsigned long)header_accepted, (unsigned long)header_expected,
+        (unsigned long)body_accepted, (unsigned long)body_expected, calls,
+        retries, (long long)(tls_diag_now_ms() - started), last_ssl_result,
+        last_errno, result);
+    tls_diag_socket(ctx, result ? "write-error" : "post-tx", 0,
+                    last_ssl_result, last_errno);
+    errno = saved_errno;
+}
+#endif
