+
+/* A frame may end before the read-ahead buffer is empty. The fd itself
+ * need not remain readable; process cached frames without a 1-second poll.
+ */
+
+static int ppp_uart_poll_timeout(FAR struct ppp_context_s *ctx)
+{
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+  if (ctx->pc_link_managed && ctx->pc_rx_position < ctx->pc_rx_length)
+    {
+      return 0;
+    }
+#else
+  (void)ctx;
+#endif
+
+  return 1000;
+}
 
