+    if (out_keep_alive) *out_keep_alive = false;
+    if (!resp_buf || !resp_cap) return VELA_TLS_ERR_PROTOCOL;
+    resp_buf[0] = 0;
+    char *raw = tls_raw_acquire();
+    tls_body_collector_t collector = {resp_buf, resp_cap, 0};
+    int64_t deadline = tls_stream_now_ms() + (int64_t)AGENT_LLM_SOCKET_TIMEOUT_SEC * 1000;
+    int result = tls_read_response_body(ctx, tls_collect_body, &collector, deadline,
+                                        true, out_keep_alive, raw, head_only);
+    tls_raw_release(raw);
+    if (result < 0) { resp_buf[0] = 0; return result; }
+    resp_buf[collector.used] = 0;
+    if (out_body_len) *out_body_len = collector.used;
+    return result;
