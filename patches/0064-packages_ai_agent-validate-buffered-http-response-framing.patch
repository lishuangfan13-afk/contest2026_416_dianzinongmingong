+
+typedef struct {
+    char *buffer;
+    size_t capacity, used;
+} tls_body_collector_t;
+
+static int tls_collect_body(const unsigned char *bytes, size_t count, void *user)
+{
+    tls_body_collector_t *collector = user;
+    if (count > collector->capacity - 1 - collector->used) return VELA_TLS_ERR_OVERFLOW;
+    memcpy(collector->buffer + collector->used, bytes, count);
+    collector->used += count;
+    return 0;
+}
