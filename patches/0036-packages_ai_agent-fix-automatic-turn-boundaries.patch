+bool voice_channel_auto_reply_is_active(const char *chat_id)
+{
+    if(!chat_id)return false;
+    pthread_mutex_lock(&s_auto.lock);
+    bool active=s_auto.enabled && s_auto.awaiting &&
+                !strcmp(s_auto.pending_id,chat_id);
+    pthread_mutex_unlock(&s_auto.lock);return active;
+}
+
+void voice_channel_auto_reply_done_for(const char *chat_id)
+{
+    pthread_mutex_lock(&s_auto.lock);
+    if(chat_id && s_auto.awaiting && !strcmp(s_auto.pending_id,chat_id)) {
+        s_auto.awaiting=false;s_auto.pending_id[0]=0;
+        s_auto.cooldown_until=auto_now_ms()+600;
+        pthread_cond_broadcast(&s_auto.changed);
+    }
+    pthread_mutex_unlock(&s_auto.lock);
+}
+
+void voice_channel_auto_reply_failed_for(const char *chat_id,int event)
+{
+    /* Keep awaiting true during the cue: the capture worker must not reopen
+     * the shared codec between clearing this turn and playing feedback. */
+    if(!voice_channel_auto_reply_is_active(chat_id))return;
+    auto_feedback_for(event,chat_id);
+    voice_channel_auto_reply_done_for(chat_id);
+}
