+/* Product voice interactions prefer a prompt final answer. MiMo v2.6-flash
+ * otherwise enables deep thinking by default. Keep other models/providers and
+ * ordinary SDK profiles unchanged, including their output token limits. */
+static void apply_product_mimo_latency(cJSON *body, const char *model,
+    const char *host)
+{
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+    bool official = !strcmp(host, "api.xiaomimimo.com")
+        || !strcmp(host, "token-plan-cn.xiaomimimo.com")
+        || !strcmp(host, "token-plan-sgp.xiaomimimo.com")
+        || !strcmp(host, "token-plan-ams.xiaomimimo.com");
+    if (official && !strcmp(model_name_for_api(model, host), "mimo-v2.6-flash")) {
+        cJSON *thinking = cJSON_AddObjectToObject(body, "thinking");
+        if (thinking) cJSON_AddStringToObject(thinking, "type", "disabled");
+    }
+#else
+    (void)body; (void)model; (void)host;
+#endif
+}
