+            (unsigned)job.daily_hour, (unsigned)job.daily_min,
+            (long long)job.next_run);
     } else {
         snprintf(output, output_size,
             "OK: Added one-shot job '%s' (id=%s), "
@@ -285,6 +328,16 @@ int tool_cron_list_execute(const char* input_json,
                 (long long)j->next_run,
