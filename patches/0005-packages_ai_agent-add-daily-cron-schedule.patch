+    char* output, size_t output_size);
 
 /* -- Private Functions ------------------------------------------- */
 
@@ -119,6 +121,38 @@ static int parse_at_schedule(cJSON* root, cron_job_t* job,
     return OK;
 }
 
+static int parse_daily_schedule(cJSON* root, cron_job_t* job,
+    char* output, size_t output_size)
+{
+    bool ok_hour;
+    bool ok_min;
+    double hour = get_numeric_value(
+        cJSON_GetObjectItem(root, "hour"), &ok_hour);
+    double minute = get_numeric_value(
+        cJSON_GetObjectItem(root, "minute"), &ok_min);
+
+    if (!ok_hour || !ok_min) {
+        snprintf(output, output_size,
+            "Error: 'daily' requires numeric 'hour' (0-23) and "
+            "'minute' (0-59)");
+        return ERROR;
+    }
+
+    if (hour < 0 || hour > 23 || minute < 0 || minute > 59) {
+        snprintf(output, output_size,
+            "Error: daily time %02d:%02d out of range "
+            "(hour 0-23, minute 0-59)",
+            (int)hour, (int)minute);
+        return ERROR;
+    }
+
+    job->kind = CRON_KIND_DAILY;
+    job->daily_hour = (uint8_t)hour;
+    job->daily_min = (uint8_t)minute;
+    job->delete_after_run = false;
+    return OK;
+}
+
 /* -- Public Functions -------------------------------------------- */
 
 int tool_cron_add_execute(const char* input_json,
@@ -211,9 +245,11 @@ int tool_cron_add_execute(const char* input_json,
         ret = parse_every_schedule(root, &job, output, output_size);
     } else if (strcmp(schedule_type, "at") == 0) {
         ret = parse_at_schedule(root, &job, output, output_size);
+    } else if (strcmp(schedule_type, "daily") == 0) {
+        ret = parse_daily_schedule(root, &job, output, output_size);
     } else {
         snprintf(output, output_size,
-            "Error: schedule_type must be 'every' or 'at'");
+            "Error: schedule_type must be 'every', 'at' or 'daily'");
         cJSON_Delete(root);
         return ERROR;
     }
@@ -239,6 +275,13 @@ int tool_cron_add_execute(const char* input_json,
             job.name, job.id,
             (unsigned long)job.interval_s,
             (long long)job.next_run);
+    } else if (job.kind == CRON_KIND_DAILY) {
