index 34509d7..103ef80 100644
--- a/src/infra/cron_service.c
+++ b/src/infra/cron_service.c
@@ -40,6 +40,8 @@ static const char* TAG = "cron";
 
 static bool cron_sanitize_destination(cron_job_t* job);
 static void cron_generate_id(char* id_buf);
+static const char* cron_kind_name(cron_kind_t kind);
+static int64_t cron_next_daily_run(uint8_t hour, uint8_t min, time_t now);
 static int cron_load_jobs(void);
 static int cron_save_jobs(void);
 static int cron_parse_job_item(cJSON* item, cron_job_t* job);
@@ -96,6 +98,55 @@ static void cron_generate_id(char* id_buf)
     snprintf(id_buf, AGENT_CRON_ID_LEN, "%08x", (unsigned int)r);
 }
 
+/* Human-readable name for a schedule kind (for logs / serialization). */
+static const char* cron_kind_name(cron_kind_t kind)
+{
+    switch (kind) {
+        case CRON_KIND_EVERY:
+            return "every";
+        case CRON_KIND_AT:
+            return "at";
+        case CRON_KIND_DAILY:
+            return "daily";
+        default:
+            return "unknown";
+    }
+}
+
+/*
+ * Compute the next occurrence (UTC epoch) of a daily job targeting the
+ * local hour:minute.  The codebase deliberately avoids localtime_r()/
+ * mktime() because NuttX tries to open zoneinfo/<TZ> from romfs, which
+ * fails for POSIX TZ strings like AGENT_TIMEZONE ("CST-8") and spams
+ * errors.  Following the convention in tool_get_time.c we apply the
+ * fixed UTC+8 offset manually:
+ *     local_epoch = utc_epoch + AGENT_TZ_OFFSET_SEC
+ *     local fields = gmtime_r(&local_epoch)
+ * and subtract the offset again to return a UTC epoch.
+ * Assumption: AGENT_TIMEZONE is a fixed "CST-8" (UTC+8, no DST).
+ */
+#define AGENT_TZ_OFFSET_SEC (8 * 3600)
+
+static int64_t cron_next_daily_run(uint8_t hour, uint8_t min, time_t now)
+{
+    struct tm local;
+    time_t local_now = now + AGENT_TZ_OFFSET_SEC;
+
+    if (!gmtime_r(&local_now, &local)) {
+        return 0;
+    }
+
+    int32_t now_sec = local.tm_hour * 3600 + local.tm_min * 60 + local.tm_sec;
+    int32_t target_sec = (int32_t)hour * 3600 + (int32_t)min * 60;
+    int32_t delta = target_sec - now_sec;
+
+    if (delta <= 0) {
+        delta += 86400;
+    }
+
+    return (int64_t)(now + delta);
+}
+
 /* Parse a single JSON object into a cron_job_t.
  * Returns OK on success, ERROR if the item should be skipped. */
 static int cron_parse_job_item(cJSON* item, cron_job_t* job)
@@ -112,6 +163,15 @@ static int cron_parse_job_item(cJSON* item, cron_job_t* job)
     }
 
     memset(job, 0, sizeof(cron_job_t));
+
+    /* id is stored in a fixed 8-char + NUL buffer.  Reject nothing, but
+     * warn and truncate deterministically so lookups stay consistent. */
+    if (strlen(id) >= sizeof(job->id)) {
+        syslog(LOG_WARNING,
+            "[%s] Job id '%s' longer than %d chars, truncating to '%.8s'\n",
+            TAG, id, (int)(sizeof(job->id) - 1), id);
+    }
+
     strncpy(job->id, id, sizeof(job->id) - 1);
     strncpy(job->name, name, sizeof(job->name) - 1);
     strncpy(job->message, message, sizeof(job->message) - 1);
@@ -137,6 +197,33 @@ static int cron_parse_job_item(cJSON* item, cron_job_t* job)
         job->at_epoch = (at_epoch && cJSON_IsNumber(at_epoch))
             ? (int64_t)at_epoch->valuedouble
             : 0;
+    } else if (strcmp(kind_str, "daily") == 0) {
+        job->kind = CRON_KIND_DAILY;
+
+        cJSON* hour_j = cJSON_GetObjectItem(item, "hour");
+        cJSON* min_j = cJSON_GetObjectItem(item, "minute");
+
+        if (!hour_j || !cJSON_IsNumber(hour_j)
+            || !min_j || !cJSON_IsNumber(min_j)) {
+            syslog(LOG_WARNING,
+                "[%s] Job '%s': 'daily' requires numeric hour and minute\n",
+                TAG, name);
+            return ERROR;
+        }
+
+        int hour = (int)hour_j->valuedouble;
+        int minute = (int)min_j->valuedouble;
+
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) {
+            syslog(LOG_WARNING,
+                "[%s] Job '%s': daily time %02d:%02d out of range "
+                "(hour 0-23, minute 0-59)\n",
+                TAG, name, hour, minute);
+            return ERROR;
+        }
+
+        job->daily_hour = (uint8_t)hour;
+        job->daily_min = (uint8_t)minute;
     } else {
         return ERROR;
     }
@@ -259,11 +346,13 @@ static int cron_save_jobs(void)
         cJSON_AddStringToObject(item, "id", job->id);
         cJSON_AddStringToObject(item, "name", job->name);
         cJSON_AddBoolToObject(item, "enabled", job->enabled);
-        cJSON_AddStringToObject(item, "kind",
-            job->kind == CRON_KIND_EVERY ? "every" : "at");
+        cJSON_AddStringToObject(item, "kind", cron_kind_name(job->kind));
 
         if (job->kind == CRON_KIND_EVERY) {
             cJSON_AddNumberToObject(item, "interval_s", job->interval_s);
+        } else if (job->kind == CRON_KIND_DAILY) {
+            cJSON_AddNumberToObject(item, "hour", job->daily_hour);
+            cJSON_AddNumberToObject(item, "minute", job->daily_min);
         } else {
             cJSON_AddNumberToObject(item, "at_epoch", (double)job->at_epoch);
         }
@@ -415,6 +504,9 @@ static void cron_process_due_jobs(void)
                 job->enabled = false;
                 job->next_run = 0;
             }
+        } else if (job->kind == CRON_KIND_DAILY) {
+            job->next_run = cron_next_daily_run(job->daily_hour,
+                job->daily_min, now);
         } else {
             job->next_run = now + job->interval_s;
         }
@@ -464,6 +556,9 @@ static void compute_initial_next_run(cron_job_t* job)
             job->next_run = 0;
             job->enabled = false;
         }
+    } else if (job->kind == CRON_KIND_DAILY) {
+        job->next_run = cron_next_daily_run(job->daily_hour, job->daily_min,
+            now);
     }
 }
 
@@ -491,6 +586,17 @@ int cron_service_start(void)
             continue;
         }
 
+        /* Daily jobs are fixed time-of-day recurrences: a missed
+         * occurrence is not stale, just advance to the next one. */
+        if (job->kind == CRON_KIND_DAILY) {
+            if (job->next_run <= now) {
+                job->next_run = cron_next_daily_run(job->daily_hour,
+                    job->daily_min, now);
+                changed = true;
+            }
+            continue;
+        }
+
         /* Stale job: next_run already set but in the past.
          * interval_s is relative to the previous action completion
          * (e.g. music playback end), so rescheduling to now+interval
@@ -574,7 +680,7 @@ int cron_add_job(cron_job_t* job)
     syslog(LOG_INFO,
         "[%s] Added job: %s (%s) kind=%s "
         "next=%lld ch=%s:%s\n",
-        TAG, job->name, job->id, job->kind == CRON_KIND_EVERY ? "every" : "at",
+        TAG, job->name, job->id, cron_kind_name(job->kind),
         (long long)job->next_run, job->channel, job->chat_id);
     return OK;
 }
