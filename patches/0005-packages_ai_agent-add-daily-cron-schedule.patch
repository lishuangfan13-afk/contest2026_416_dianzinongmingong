 /**
  * Add a scheduled cron job.
- * Input JSON: { name, schedule_type ("every"/"at"), interval_s, at_epoch,
+ * Input JSON: { name, schedule_type ("every"/"at"/"daily"),
+ *               interval_s, at_epoch, hour, minute,
