+#ifdef CONFIG_ZHAOXI_BES_AUDIO
+/* Proposed helper for CONFIG_ZHAOXI_BES_AUDIO only.
+ * DNS retains NuttX's configured retry bound; the deadline below applies to
+ * the TCP stage after resolution. The product sets IPv4 DNS once at startup. */
+static int zhaoxi_tcp_connect(mbedtls_net_context *net, const char *host,
+                              const char *port, unsigned timeout_ms)
+{
+    struct addrinfo hints = {0}, *addresses = NULL;
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_protocol = IPPROTO_TCP;
+    if (getaddrinfo(host, port, &hints, &addresses) != 0)
+        return MBEDTLS_ERR_NET_UNKNOWN_HOST;
+
+    struct timespec start;
+    clock_gettime(CLOCK_MONOTONIC, &start);
+    int64_t deadline = (int64_t)start.tv_sec * 1000 + start.tv_nsec / 1000000 + timeout_ms;
+    int result = MBEDTLS_ERR_NET_CONNECT_FAILED;
+    for (struct addrinfo *at = addresses; at; at = at->ai_next) {
+        int fd = socket(at->ai_family, at->ai_socktype, at->ai_protocol);
+        if (fd < 0) continue;
+        int flags = fcntl(fd, F_GETFL, 0);
+        if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+            close(fd);
+            continue;
+        }
+        int rc = connect(fd, at->ai_addr, at->ai_addrlen);
+        if (rc != 0 && errno == EINPROGRESS) {
+            for (;;) {
+                struct timespec now;
+                clock_gettime(CLOCK_MONOTONIC, &now);
+                int64_t left = deadline - (int64_t)now.tv_sec * 1000 - now.tv_nsec / 1000000;
+                if (left <= 0) { rc = -1; errno = ETIMEDOUT; break; }
+                fd_set writefds;
+                FD_ZERO(&writefds);
+                FD_SET(fd, &writefds);
+                struct timeval tv = { .tv_sec = left / 1000,
+                                      .tv_usec = (left % 1000) * 1000 };
+                rc = select(fd + 1, NULL, &writefds, NULL, &tv);
+                if (rc < 0 && errno == EINTR) continue;
+                if (rc <= 0) { if (!rc) errno = ETIMEDOUT; rc = -1; break; }
+                int error = 0;
+                socklen_t size = sizeof(error);
+                rc = getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size);
+                if (rc == 0 && error) { errno = error; rc = -1; }
+                break;
+            }
+        }
+        if (rc == 0 && fcntl(fd, F_SETFL, flags) == 0) {
+            net->fd = fd;
+            result = 0;
+            break;
+        }
+        close(fd);
+    }
+    freeaddrinfo(addresses);
+    return result;
+}
+#endif
