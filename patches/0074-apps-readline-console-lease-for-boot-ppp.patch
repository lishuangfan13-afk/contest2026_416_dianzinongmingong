  * Private Functions
  ****************************************************************************/
 
+/* Product hooks are a pair. Without both, including on non-product builds,
+ * preserve the original blocking read/write behavior. begin returns 0 for an
+ * unrelated fd, 1 with the console gate held, or a negative errno. The product
+ * recognizes /dev/console, not every isatty fd. No product header dependency.
+ */
+
+extern int zhaoxi_console_readline_begin(int fd) __attribute__((weak));
+extern void zhaoxi_console_readline_end(void) __attribute__((weak));
+
+static int readline_console_begin(int fd, bool wait)
+{
+  int ret;
+
+  if (!zhaoxi_console_readline_begin || !zhaoxi_console_readline_end)
+    {
+      return 0;
+    }
+
+  for (;;)
+    {
+      ret = zhaoxi_console_readline_begin(fd);
+      if (ret != -EAGAIN || !wait)
+        {
+          return ret;
+        }
+
+      /* PPP owns the console: wait without reading or echoing. A release
+       * resumes readline within 100 ms (plus normal scheduler latency).
+       */
+
+      struct timespec pause = {0, 100000000L};
+      if (nanosleep(&pause, NULL) < 0 && errno != EINTR)
+        {
+          return -errno;
+        }
+    }
+}
+
