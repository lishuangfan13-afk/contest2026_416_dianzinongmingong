@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#define VOICE_WAKE_WINDOW_MS UINT64_C(60000)
+#define VOICE_WAKE_INITIALIZER { .enabled = true }
+typedef struct {
+    bool enabled;
+    bool awake;
+    bool busy;
+    uint64_t deadline_ms;
+} voice_wake_t;
+typedef enum {
+    VOICE_WAKE_IGNORE = 0,
+    VOICE_WAKE_COMMAND,
+    VOICE_WAKE_ONLY,
+    VOICE_WAKE_SLEEP,
+    VOICE_WAKE_STOP,
+    VOICE_WAKE_REJECTED
+} voice_wake_result_t;
+/* Pure gate over ASR text, never an offline keyword detector. All timestamps
+ * are monotonic milliseconds. Caller serializes access to the state. */
+void voice_wake_reset(voice_wake_t *state);
+void voice_wake_set_enabled(voice_wake_t *state, bool enabled);
+bool voice_wake_poll(voice_wake_t *state, uint64_t now_ms);
+void voice_wake_set_busy(voice_wake_t *state, bool busy, uint64_t now_ms);
+voice_wake_result_t voice_wake_process(voice_wake_t *state, const char *asr_text,
+                                      uint64_t now_ms, char *command, size_t capacity);
