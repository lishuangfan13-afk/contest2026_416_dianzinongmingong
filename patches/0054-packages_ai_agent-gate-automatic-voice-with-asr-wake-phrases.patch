@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "voice/voice_wake.h"
+#include <string.h>
+
+static uint64_t next_deadline(uint64_t now)
+{
+    return now > UINT64_MAX - VOICE_WAKE_WINDOW_MS ? UINT64_MAX : now + VOICE_WAKE_WINDOW_MS;
+}
+static const char *skip_separators(const char *text)
+{
+    static const char *unicode[] = {"，", "。", "、", "！", "？", "：", "；", "“", "”", "‘", "’", "　", "\xc2\xa0", NULL};
+    for (;;) {
+        if (*text && strchr(" \t\r\n,.:;!?\"'", (unsigned char)*text)) { text++; continue; }
+        int found = 0;
+        for (int i = 0; unicode[i]; i++) {
+            size_t n = strlen(unicode[i]);
+            if (!strncmp(text, unicode[i], n)) { text += n; found = 1; break; }
+        }
+        if (!found) return text;
+    }
+}
+static const char *consume(const char *text, const char *part)
+{
+    size_t n = strlen(part);
+    return !strncmp(text, part, n) ? skip_separators(text + n) : NULL;
+}
+static const char *wake_prefix(const char *text)
+{
+    const char *name = text;
+    const char *greeting = consume(text, "你");
+    if (greeting) {
+        greeting = consume(greeting, "好");
+        if (!greeting) return NULL;
+        name = greeting;
+    } else {
+        const char *small = consume(text, "小");
+        if (small) name = small;
+    }
+    const char *after = consume(name, "朝");
+    return after ? consume(after, "夕") : NULL;
+}
+static bool exact_control(const char *text, const char *phrase)
+{
+    size_t n = strlen(phrase);
+    if (strncmp(text, phrase, n)) return false;
+    const char *tail = skip_separators(text + n);
+    if (!strncmp(tail, "吧", strlen("吧"))) tail = skip_separators(tail + strlen("吧"));
+    return !*tail;
+}
+void voice_wake_reset(voice_wake_t *state)
+{
+    if (!state) return;
+    state->awake = false;
+    state->busy = false;
+    state->deadline_ms = 0;
+}
+void voice_wake_set_enabled(voice_wake_t *state, bool enabled)
+{
+    if (!state) return;
+    voice_wake_reset(state);
+    state->enabled = enabled;
+}
+bool voice_wake_poll(voice_wake_t *state, uint64_t now)
+{
+    if (!state) return false;
+    if (state->enabled && state->awake && !state->busy && now >= state->deadline_ms)
+        state->awake = false;
+    return !state->enabled || state->awake;
+}
+void voice_wake_set_busy(voice_wake_t *state, bool busy, uint64_t now)
+{
+    if (!state) return;
+    voice_wake_poll(state, now);
+    if (state->busy == busy) return;
+    state->busy = busy;
+    if (!busy && state->awake) state->deadline_ms = next_deadline(now);
+}
+static voice_wake_result_t empty_result(char *command, voice_wake_result_t result)
+{
+    command[0] = 0;
+    return result;
+}
+voice_wake_result_t voice_wake_process(voice_wake_t *state, const char *text,
+                                      uint64_t now, char *command, size_t capacity)
+{
+    if (!state || !text || !command || !capacity) return VOICE_WAKE_REJECTED;
+    if (command != text) command[0] = 0;
+    bool active = voice_wake_poll(state, now);
+    text = skip_separators(text);
+    if (!*text) return empty_result(command, VOICE_WAKE_IGNORE);
+    const char *after = wake_prefix(text);
+    bool prefixed = after != NULL;
+    if (after) text = after;
+    /* A direct stop remains available even before wake, for privacy. */
+    if (exact_control(text,"停止监听") || exact_control(text,"请停止监听")) {
+        voice_wake_reset(state);
+        return empty_result(command, VOICE_WAKE_STOP);
+    }
+    if (state->enabled && (active || prefixed) &&
+        (exact_control(text,"再见") || exact_control(text,"休息吧") || exact_control(text,"结束对话"))) {
+        voice_wake_reset(state);
+        return empty_result(command, VOICE_WAKE_SLEEP);
+    }
+    if (prefixed) {
+        state->awake = true;
+        state->deadline_ms = next_deadline(now);
+        if (!*text) return empty_result(command, VOICE_WAKE_ONLY);
+    } else if (state->enabled && !active) return empty_result(command, VOICE_WAKE_IGNORE);
+    size_t length = strlen(text);
+    if (length >= capacity) return empty_result(command, VOICE_WAKE_REJECTED);
+    memmove(command, text, length + 1);
+    return VOICE_WAKE_COMMAND;
+}
