+/* Publish startup outcome before waking voice_channel_start(). On failure,
+ * the starter joins the worker and owns cleanup of the returned stream. */
+static void recording_start_complete(int result, voice_asr_stream_t *stream)
+{
+    pthread_mutex_lock(&s_voice.lock);
+    s_voice.rec_start_result = result;
+    if (result != 0) s_voice.asr_stream = stream;
+    pthread_mutex_unlock(&s_voice.lock);
+    sem_post(&s_voice.rec_ready);
+}
