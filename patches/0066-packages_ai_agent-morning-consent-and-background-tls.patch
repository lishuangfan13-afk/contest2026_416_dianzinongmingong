+/* Dedicated bounded connection for background work. Normal ASR/TTS and LLM
+ * calls retain their existing timeout and connection behaviour. */
+int vela_https_post_json_bounded(const char *host,const char *port,const char *path,
+    const vela_header_t *headers,const char *body,char *out,size_t capacity,
+    unsigned budget,int (*cancel)(void *),void *user)
+{
+    if(!host || !port || !path || !body || !out || !capacity || budget<1000 || budget>60000)
+        return VELA_TLS_ERR_PROTOCOL;
+    out[0]=0;
+    vela_header_t merged[16]={{"Content-Type","application/json"}};unsigned count=1;
+    if(headers)for(;headers->name && count<15;headers++)merged[count++]=*headers;
+    merged[count]=(vela_header_t){NULL,NULL};
+    tls_ctx_t *ctx=calloc(1,sizeof(*ctx));if(!ctx)return VELA_TLS_ERR_OVERFLOW;
+    int rc=tls_ctx_connect_limited(ctx,host,port,budget,cancel,user);
+    if(!rc)rc=tls_write_request(ctx,"POST",host,path,merged,body,strlen(body));
+    if(!rc)rc=tls_read_response(ctx,out,capacity,NULL,NULL,false);
+    tls_ctx_free(ctx);free(ctx);
+    if(rc<0)out[0]=0;
+    return rc;
+}
