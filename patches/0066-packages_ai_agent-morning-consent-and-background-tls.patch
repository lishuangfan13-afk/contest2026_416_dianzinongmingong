+static int64_t bounded_now_ms(void)
+{
+    struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);
+    return (int64_t)t.tv_sec*1000+t.tv_nsec/1000000;
+}
+static int bounded_socket_ready(tls_ctx_t *ctx,int option)
+{
+    if(ctx->request_cancel && ctx->request_cancel(ctx->request_user))return MBEDTLS_ERR_SSL_TIMEOUT;
+    int64_t left=ctx->request_deadline-bounded_now_ms();
+    if(left<=0)return MBEDTLS_ERR_SSL_TIMEOUT;
+    if(left>1000)left=1000;
+    struct timeval tv={.tv_sec=left/1000,.tv_usec=(left%1000)*1000};
+    return setsockopt(ctx->net.fd,SOL_SOCKET,option,&tv,sizeof(tv))?MBEDTLS_ERR_NET_RECV_FAILED:0;
+}
+static int bounded_recv(void *opaque,unsigned char *buf,size_t size)
+{
+    tls_ctx_t *ctx=opaque;int rc=bounded_socket_ready(ctx,SO_RCVTIMEO);if(rc)return rc;
+    rc=mbedtls_net_recv(&ctx->net,buf,size);
+    if(rc==MBEDTLS_ERR_NET_RECV_FAILED && (errno==EAGAIN || errno==EWOULDBLOCK))
+        return bounded_now_ms()>=ctx->request_deadline?MBEDTLS_ERR_SSL_TIMEOUT:MBEDTLS_ERR_SSL_WANT_READ;
+    return rc;
+}
+static int bounded_send(void *opaque,const unsigned char *buf,size_t size)
+{
+    tls_ctx_t *ctx=opaque;int rc=bounded_socket_ready(ctx,SO_SNDTIMEO);if(rc)return rc;
+    rc=mbedtls_net_send(&ctx->net,buf,size);
+    if(rc==MBEDTLS_ERR_NET_SEND_FAILED && (errno==EAGAIN || errno==EWOULDBLOCK))
+        return bounded_now_ms()>=ctx->request_deadline?MBEDTLS_ERR_SSL_TIMEOUT:MBEDTLS_ERR_SSL_WANT_WRITE;
+    return rc;
+}
