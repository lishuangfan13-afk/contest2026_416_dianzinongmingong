-static void auto_feedback(int event) { auto_feedback_for(event,NULL); }
+static int64_t auto_now_ms(void);
+static void auto_feedback(int event)
+{
+    if(event==VOICE_AUTO_FEEDBACK_ASR_ERROR || event==VOICE_AUTO_FEEDBACK_TOO_LONG ||
+       event==VOICE_AUTO_FEEDBACK_CAPTURE_ERROR) {
+        pthread_mutex_lock(&s_auto.lock);
+        bool sleeping=s_auto.wake.enabled && !voice_wake_poll(&s_auto.wake,(uint64_t)auto_now_ms()) && !s_auto.news_consent;
+        pthread_mutex_unlock(&s_auto.lock);
+        /* Incidental noise/cloud failures before wake must not generate a
+         * speaker cue that can itself be captured as the next utterance. */
+        if(sleeping)return;
+    }
+    auto_feedback_for(event,NULL);
+}
 
