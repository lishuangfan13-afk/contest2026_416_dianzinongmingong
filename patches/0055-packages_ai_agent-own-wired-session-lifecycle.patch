+uint64_t agent_session_owner_new(void)
+{
+    pthread_mutex_lock(&lock);
+    uint64_t owner = 0;
+    if (!pending_owner) {
+        if (++owner_sequence == 0) ++owner_sequence;
+        owner = pending_owner = owner_sequence;
+    }
+    pthread_mutex_unlock(&lock);
+    return owner;
+}
+
+bool agent_instance_acquire_owned(uint64_t owner, void (*prepare)(void))
+{
+    pthread_mutex_lock(&lock);
+    bool acquired = !active && (!owner || owner == pending_owner);
+    if (acquired) {
+        /* Initialize shutdown under the same lock before ownership becomes
+         * observable; an immediate stop cannot be erased by late startup. */
+        if (prepare) prepare();
+        active = true;
+        active_owner = owner;
+        if (owner) pending_owner = 0;
+    }
+    pthread_mutex_unlock(&lock);
+    return acquired;
+}
