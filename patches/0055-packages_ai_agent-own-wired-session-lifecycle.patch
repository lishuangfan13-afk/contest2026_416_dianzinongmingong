 void agent_instance_release(void)
 {
     pthread_mutex_lock(&lock);
     active = false;
+    active_owner = 0;
+    pthread_cond_broadcast(&changed);
     pthread_mutex_unlock(&lock);
+}
+
+bool agent_instance_is_active(void)
+{
+    pthread_mutex_lock(&lock);
+    bool result = active;
+    pthread_mutex_unlock(&lock);
+    return result;
+}
+
+bool agent_instance_is_owned(uint64_t owner)
+{
+    pthread_mutex_lock(&lock);
+    bool result = owner && active && active_owner == owner;
+    pthread_mutex_unlock(&lock);
+    return result;
+}
+
+bool agent_instance_shutdown_owned(uint64_t owner)
+{
+    if (!owner) return false;
+    pthread_mutex_lock(&lock);
+    if (pending_owner == owner) pending_owner = 0;
+    bool owned = active && active_owner == owner;
+    if (owned) agent_request_shutdown();
+    pthread_mutex_unlock(&lock);
+    return owned;
+}
+
+int agent_instance_wait_owned(uint64_t owner, unsigned timeout_ms)
+{
+    if (!owner) return -EINVAL;
+    struct timespec begin, now;
+    if (clock_gettime(CLOCK_MONOTONIC, &begin)) return -errno;
+    for (;;) {
+        if (!agent_instance_is_owned(owner)) return 0;
+        if (clock_gettime(CLOCK_MONOTONIC, &now)) return -errno;
+        int64_t elapsed = (int64_t)(now.tv_sec - begin.tv_sec) * 1000 +
+                          (now.tv_nsec - begin.tv_nsec) / 1000000;
+        if (elapsed >= (int64_t)timeout_ms) return -ETIMEDOUT;
+        unsigned remaining = timeout_ms - (unsigned)(elapsed > 0 ? elapsed : 0);
+        /* A short monotonic poll remains bounded even if host UTC is adjusted
+         * during shutdown; no realtime condition deadline can jump backwards. */
+        struct timespec pause = {.tv_sec = 0,
+            .tv_nsec = (long)(remaining < 20 ? remaining : 20) * 1000000};
+        nanosleep(&pause, NULL);
+    }
 }
 
