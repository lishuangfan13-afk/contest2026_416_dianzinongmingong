+/* A transport turn ID must not split the user's conversation history. */
+static bool automatic_voice_message(const agent_msg_t *msg)
+{
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+    return !strcmp(msg->channel, AGENT_CHAN_VOICE) &&
+           !strncmp(msg->chat_id, "voice_auto_", 11);
+#else
+    (void)msg; return false;
+#endif
+}
+
+static const char *conversation_id(const agent_msg_t *msg)
+{
+    return automatic_voice_message(msg) ? "voice_auto" : msg->chat_id;
+}
+
+static bool automatic_voice_cancelled(const agent_msg_t *msg)
+{
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+    return automatic_voice_message(msg) &&
+           !voice_channel_auto_reply_is_active(msg->chat_id);
+#else
+    (void)msg; return false;
+#endif
+}
+
+/* Consume the reply buffer on every path, including a full queue or cancellation. */
+static void push_final_reply(const agent_msg_t *msg, char *content)
+{
+    if (automatic_voice_cancelled(msg)) { free(content); return; }
+    if (content && content[0]) {
+        agent_msg_t out = {0};
+        strncpy(out.channel, msg->channel, sizeof(out.channel)-1);
+        strncpy(out.chat_id, msg->chat_id, sizeof(out.chat_id)-1);
+        out.content = content;
+        if (message_bus_push_outbound(&out) == OK) return;
+    }
+    free(content);
+#ifdef CONFIG_EXAMPLES_ZHAOXI
+    if (automatic_voice_message(msg))
+        voice_channel_auto_reply_failed_for(msg->chat_id,
+                                            VOICE_AUTO_FEEDBACK_DISPATCH_ERROR);
+#endif
 }
 
